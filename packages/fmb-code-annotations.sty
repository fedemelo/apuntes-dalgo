\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fmb-code-annotations}[2026/05/10 Code annotation infrastructure by Federico Melo Barrero.]

\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,positioning,fit,decorations.pathreplacing}
\RequirePackage{caption}
\RequirePackage{xparse}

% Caption type for \codeblock listings, numbered independently of figures/tables.
\DeclareCaptionType{implementacion}[Implementación]
\captionsetup[implementacion]{font=small, skip=4pt}

% Place a zero-size remembered node at the current position.
\newcommand{\tikzmark}[1]{\tikz[remember picture,overlay] \node (#1) {};}

% Shorthand for brace marks: |\br{id}|
\newcommand{\br}[1]{\tikzmark{#1}}

% Shorthand pair for box marks: |\bxl{id}|TOKEN|\bxr{id}|
\newcommand{\bxl}[1]{\tikzmark{#1s}}
\newcommand{\bxr}[1]{\tikzmark{#1e}}

\tikzset{
  box/.style={draw=green!55!black, line width=0.7pt,
              rounded corners=3pt, inner xsep=0pt, inner ysep=2pt, yshift=2pt},
  note/.style={align=left, font=\scriptsize\fontfamily{cmss}\selectfont,
               text=green!50!black, inner sep=5pt},
  arr/.style={-{Stealth[length=2mm,open]}, draw=green!55!black, line width=0.7pt},
  brk/.style={draw=green!55!black, line width=0.7pt},
}



% Curly brace spanning a vertical range of code, with an inline label

% -------------------------------------------------
%
%   \codebrace[<options>]{<top>}{<bottom>}{<text>}
%
% -------------------------------------------------
% Mandatory arguments
% -------------------------------------------------
%
%   {<top>}
%       TikZ coordinate/node marking the TOP of the
%       brace span.
%
%   {<bottom>}
%       TikZ coordinate/node marking the BOTTOM of
%       the brace span.
%
%   {<text>}
%       Text displayed next to the brace.
%
% -------------------------------------------------
% Optional key-value options
% -------------------------------------------------
%
%   xshift=<dimension>
%       Horizontal displacement of the brace from
%       the bottom mark.
%
%       Positive values move the brace right.
%       Negative values move it left.
%
%       Default:
%           15pt
%
%   noteshift=<dimension>
%       Horizontal distance between the brace tip
%       and the annotation text.
%
%       Default:
%           0pt
%
%   yshift=<dimension>
%       Vertical displacement of the annotation text
%       relative to the brace midpoint.
%
%       Positive values move the text up.
%       Negative values move it down.
%
%       Default:
%           0pt
%
%   width=<dimension>
%       Text width of the annotation node.
%
%       Useful for wrapping long explanations.
%
%       Default:
%           3cm
%
%   amplitude=<dimension>
%       Curvature size of the curly brace.
%
%       Larger values produce "deeper" braces.
%
%       Default:
%           3pt

\pgfkeys{
    /codebrace/.is family,
    /codebrace,
    default/.style = {
        xshift = 15pt,
        noteshift = 0pt,
        yshift = 0pt,
        width = 3cm,
        amplitude = 3pt
    },
    xshift/.estore in = \codebracexshift,
    noteshift/.estore in = \codebracenoteshift,
    yshift/.estore in = \codebraceyshift,
    width/.estore in = \codebracewidth,
    amplitude/.estore in = \codebraceamplitude,
}

\NewDocumentCommand{\codebrace}{O{} m m m}{%
    \pgfkeys{/codebrace, default, #1}
    \coordinate (brace@x)
        at ([xshift=\codebracexshift] #3);
    \draw[
        brk,
        decorate,
        decoration = {
            brace,
            amplitude=\codebraceamplitude
        }
    ]
        ($ (brace@x |- #2) + (0, \dimexpr\ht\strutbox - 3pt\relax) $)
        --
        (brace@x |- #3)
        node[
            midway,
            note,
            anchor=west,
            xshift=\the\dimexpr\codebraceamplitude+\codebracenoteshift\relax,
            yshift=\codebraceyshift,
            text width=\codebracewidth
        ]
        {#4};
}

% A floating note pointing at a code token/span via an arrow, with an
% optional box drawn around the marked span.
%
% -------------------------------------------------
%
%   \codenote[<options>]{<id>}{<text>}
%
% -------------------------------------------------
% Marks in the listing
% -------------------------------------------------
%
%   Place |\bxl{id}| before the span and |\bxr{id}| after it.
%
% Mandatory arguments
% -------------------------------------------------
%
%   {<id>}
%       Base name matching the \bxl{id}/\bxr{id} marks.
%
%   {<text>}
%       Explanation text in the note.
%
% -------------------------------------------------
% Optional key-value options
% -------------------------------------------------
%
%   box=<boolean>
%       Whether to draw a rounded box around the marked span.
%       Turn this on for a token/sub-expression inside a longer
%       line; leave it off (default) when the span is the whole
%       line, where the arrow alone already points unambiguously
%       and a box around the full line adds nothing.
%
%       Default:
%           false
%
%   xshift=<dimension>
%       Horizontal distance from the span to the note.
%       Controls the arrow length in the default layout.
%       Ignored when notepos is set explicitly.
%
%       Default:
%           1.5cm
%
%   yshift=<dimension>
%       Vertical displacement of the note from its default position.
%       Ignored when notepos is set explicitly.
%
%       Default:
%           0pt
%
%   notepos=<calc expression>
%       Where to place the note, written as a TikZ
%       calc expression without the outer ($ ... $).
%       E.g.: (cn@id.east)+(2cm,1cm)
%             (current page.east)+(-8.5cm,-0.5cm)
%       Overrides xshift/yshift when set.
%
%       Default:
%           auto (xshift/yshift to the right of the span)
%
%   noteanchor=<anchor>
%       Anchor of the note node used for positioning.
%
%       Default:
%           west
%
%   from=<anchor>
%       Span anchor where the arrow starts.
%
%       Default:
%           east
%
%   to=<anchor>
%       Note anchor where the arrow ends.
%
%       Default:
%           west
%
%   curve=<to-path options>
%       TikZ to-path options controlling the arrow shape.
%       E.g.: bend left=25, out=90 in=180
%
%       Default:
%           {} (straight line)
%
%   arrstyle=<draw options>
%       Extra options passed to \draw for the arrow.
%       E.g.: solid, dashed
%
%       Default:
%           dotted
%
%   width=<dimension>
%       Text width of the note node.
%
%       Default:
%           3cm

\pgfkeys{
    /codenote/.is family,
    /codenote,
    default/.style = {
        box        = false,
        notepos    = auto,
        noteanchor = west,
        xshift     = 1.5cm,
        yshift     = 0pt,
        from       = east,
        to         = west,
        curve      = {},
        arrstyle   = dotted,
        width      = 3cm,
    },
    box/.is if      = codenotebox,
    notepos/.store     in = \codenotenotepos,
    noteanchor/.estore in = \codenotenoteanchor,
    xshift/.estore     in = \codenotenotexshift,
    yshift/.estore     in = \codenotenoteyshift,
    from/.estore       in = \codenotefrom,
    to/.estore         in = \codenoteto,
    curve/.code           = {\tikzset{codenote@curve@style/.style={#1}}},
    arrstyle/.estore   in = \codenotearrstyle,
    width/.estore      in = \codenotewidth,
}

\newif\ifcodenotebox

\NewDocumentCommand{\codenote}{O{} m m}{%
    \pgfkeys{/codenote, default, #1}%
    \ifcodenotebox
        \node[box, fit=(#2s)(#2e)] (cn@#2) {};%
    \else
        \node[box, draw=none, fit=(#2s)(#2e)] (cn@#2) {};%
    \fi
    \def\codenote@auto{auto}%
    \ifx\codenotenotepos\codenote@auto
        \node[note, anchor=\codenotenoteanchor, text width=\codenotewidth]
            (cnote@#2) at ([xshift=\codenotenotexshift, yshift=\codenotenoteyshift] cn@#2.east) {#3};%
    \else
        \edef\codenote@pos{($ \codenotenotepos $)}%
        \node[note, anchor=\codenotenoteanchor, text width=\codenotewidth]
            (cnote@#2) at \codenote@pos {#3};%
    \fi
    \draw[arr, \codenotearrstyle]
        (cn@#2.\codenotefrom) to[codenote@curve@style] (cnote@#2.\codenoteto);%
}

% \nointerlineskip: starting this environment right after a listing opens a
% new paragraph, which would otherwise insert real interline glue before
% content that's supposed to occupy zero space (it's `overlay`).
\NewDocumentEnvironment{annotations}{}{%
    \par\nointerlineskip
    \begin{tikzpicture}[remember picture, overlay]
}{%
    \end{tikzpicture}
}

% Wrap a \pseudocode listing, its optional \annotations, and an optional
% caption together, so they land on one page and one page only:
%
%   \begin{codeblock}[Conteo de pares invertidos.][impl:pares-invertidos]
%     \begin{pseudocode} ... \end{pseudocode}
%     \begin{annotations} ... \end{annotations}
%   \end{codeblock}
%
% \annotations is `overlay`, so it has zero size for page-breaking purposes:
% without this wrapper, the page builder could break right after the
% listing, stranding the (seemingly weightless) annotations — or the
% caption — on the next page, disconnected from what they annotate.
% Capturing everything in one \vbox makes it a single, unsplittable item.
%
% \parskip is forced to 0pt because the `parskip` package (loaded by the
% class) would otherwise add visible space at each paragraph break inside
% the box (before \annotations, and before the caption), even though
% those breaks have no content of their own to justify it.
\newbox\codeblock@box
\NewDocumentEnvironment{codeblock}{o o}{%
    \par
    \setbox\codeblock@box=\vbox\bgroup
    \parskip=0pt\relax
}{%
    \IfValueT{#1}{\par\nointerlineskip\captionof{implementacion}{#1}}%
    \IfValueT{#2}{\label{#2}}%
    \egroup
    \noindent\box\codeblock@box
}
